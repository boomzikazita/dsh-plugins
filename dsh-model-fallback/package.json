{
  "name": "@boomzzzzzz/dsh-model-fallback",
  "version": "0.4.0",
  "type": "module",
  "main": "index.js",
  "description": "主模型调用失败时自动切换到备用 provider/model（挂 llm/stream 瀑布，error 终态且未产出内容时按链切换）。设置页面板可视化管理链（模型目录下拉联动）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boomzikazita/dsh-plugins.git",
    "directory": "dsh-model-fallback"
  }
}